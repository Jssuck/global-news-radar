# Global News Radar MVP 配置示例（复制为 .env 使用）
# 默认轮询间隔（秒），源级 interval 优先于此值
GNR_POLL_INTERVAL=600
# SQLite 数据库路径
GNR_DB_PATH=data/gnr.db
# 每次抓 feed 最多处理的新文章数
GNR_MAX_ARTICLES_PER_FETCH=20
# HTTP 请求超时（秒）
GNR_REQUEST_TIMEOUT=15
# 地域代理配置文件（MVP 只读展示，不做真实代理转发）
GNR_PROXY_CONFIG=config/proxies.yaml
# 置 1 时禁用后台轮询（测试用）
GNR_DISABLE_POLLER=0
